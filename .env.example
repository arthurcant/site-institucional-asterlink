# Servidor local
PORT=3000
CORS_ORIGIN=*

# SMTP Zoho Mail
# Confira o servidor exato em Zoho Mail > Settings > Mail Accounts > Server Configuration Details.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true

# Use o endereço completo da conta Zoho e uma senha específica de aplicativo.
ZOHO_MAIL_USER=contato@seudominio.com.br
ZOHO_MAIL_PASSWORD=cole_a_senha_de_aplicativo_aqui

# O remetente deve ser a própria conta autenticada ou um alias autorizado nela.
ZOHO_MAIL_FROM=contato@seudominio.com.br
ZOHO_MAIL_TO=contato@seudominio.com.br
